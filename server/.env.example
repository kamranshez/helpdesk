# ── Development defaults ──────────────────────────────────────────────────────
PORT=3000
CLIENT_URL=http://localhost:5173
TRUSTED_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://helpdesk:helpdesk@localhost:5432/helpdesk?schema=public
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32

# ── Seeding ───────────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CHANGE_ME_BEFORE_RUNNING

# ── AI (required) ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Email (optional) ──────────────────────────────────────────────────────────
MAILERSEND_API_KEY=
MAILERSEND_FROM_EMAIL=
MAILERSEND_FROM_NAME=
EMAIL_WEBHOOK_SECRET=
CLOUDMAILIN_WEBHOOK_SECRET=

# ── Observability (optional) ──────────────────────────────────────────────────
SENTRY_DSN=

# ── Production overrides (Railway) ────────────────────────────────────────────
# NODE_ENV=production
# CLIENT_URL=https://your-app.railway.app
# TRUSTED_ORIGIN=https://your-app.railway.app
# DATABASE_URL=  (set automatically by Railway PostgreSQL plugin)
